---
import { home } from '../data/home';
---

<section class="section">
  <div class="wrap">
    <h2 class="text-2xl font-semibold md:text-3xl">{home.howHeading}</h2>
    <ol class="mt-8 grid gap-6 md:grid-cols-3">
      {home.steps.map((step, index) => (
        <li class="border border-line bg-elevated p-5">
          <p class="text-sm font-semibold text-accent">{index + 1}</p>
          <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
