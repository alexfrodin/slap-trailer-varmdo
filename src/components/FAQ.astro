---
interface Props {
  heading?: string;
  items: { q: string; a: string }[];
}

const { heading = 'Vanliga frågor', items } = Astro.props;
---

{items.length > 0 && (
  <section class="section">
    <div class="wrap max-w-3xl">
      <h2 class="text-2xl font-semibold md:text-3xl">{heading}</h2>
      <div class="mt-6 divide-y divide-line border-y border-line">
        {items.map((item) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-semibold marker:content-none">
              <span class="flex items-center justify-between gap-4">
                {item.q}
                <span aria-hidden="true" class="text-accent group-open:hidden">+</span>
                <span aria-hidden="true" class="hidden text-accent group-open:inline">−</span>
              </span>
            </summary>
            <p class="mt-3 text-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
