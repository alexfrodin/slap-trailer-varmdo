---
import { legalLine, site } from '../data/site';
import { nav } from '../data/home';
import { footerExtraLinks, serviceLinks } from '../data/navigation';
import PhoneLink from './PhoneLink.astro';
---

<footer class="border-t border-line bg-elevated">
  <div class="wrap grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="font-semibold text-accent">{site.brandName}</p>
      <p class="mt-2 max-w-xs text-muted">
        Service och reparation av släpvagnar i verkstaden på Värmdö.
      </p>
    </div>
    <div>
      <p class="mb-3 font-semibold">{nav.services}</p>
      <ul class="space-y-2">
        {serviceLinks.map((link) => (
          <li>
            <a class="text-ink no-underline hover:underline" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="mb-3 font-semibold">{nav.contact}</p>
      <p>
        <PhoneLink class="font-semibold text-accent no-underline" />
      </p>
      <p class="mt-2 text-muted">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}
      </p>
      <p class="mt-2">
        <a class="text-ink hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <ul class="mt-4 space-y-2">
        {footerExtraLinks.map((link) => (
          <li>
            <a class="text-ink no-underline hover:underline" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="wrap py-5 text-sm text-muted">{legalLine()}</p>
  </div>
</footer>
