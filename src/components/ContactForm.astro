---
import { cta, home } from '../data/home';
import { trailerTypes } from '../lib/validation';
import CTAButton from './CTAButton.astro';

interface Props {
  heading?: string;
  lead?: string;
}

const { heading = home.formHeading, lead = home.formLead } = Astro.props;

const error = Astro.url.searchParams.get('fel');
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="forfragan" class="section scroll-mt-24 bg-elevated">
  <div class="wrap max-w-2xl">
    <h2 class="text-2xl font-semibold md:text-3xl">{heading}</h2>
    <p class="mt-3 text-muted">{lead}</p>

      {error && (
        <p class="mt-4 border border-cta px-4 py-3 text-cta" role="alert">
          {error === 'validering'
            ? 'Kontrollera namn, telefon och beskrivning.'
            : 'Vi kunde inte skicka formuläret. Ring oss eller försök igen.'}
        </p>
      )}

      <form
        class="mt-6 grid gap-4"
        action="/api/contact"
        method="POST"
        data-contact-form
      >
        <input type="hidden" name="startedAt" data-started-at />

        <div class="hp" aria-hidden="true">
          <label for="company">Företag</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="name">Namn (obligatorisk)</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            minlength="2"
            maxlength="80"
            autocomplete="name"
            class="w-full border border-line bg-surface px-3 py-2.5"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="phone">Telefonnummer (obligatorisk)</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            class="w-full border border-line bg-surface px-3 py-2.5"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="email">E-post</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            class="w-full border border-line bg-surface px-3 py-2.5"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="regNumber">Registreringsnummer</label>
          <input
            id="regNumber"
            name="regNumber"
            type="text"
            maxlength="16"
            class="w-full border border-line bg-surface px-3 py-2.5 uppercase"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="trailerType">Typ av släp (obligatorisk)</label>
          <select
            id="trailerType"
            name="trailerType"
            required
            class="w-full border border-line bg-surface px-3 py-2.5"
          >
            <option value="">Välj typ av släp</option>
            {trailerTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>

        <div>
          <label class="mb-1 block font-medium" for="message">Vad behöver du hjälp med? (obligatorisk)</label>
          <textarea
            id="message"
            name="message"
            required
            minlength="10"
            maxlength="2000"
            rows="5"
            class="w-full border border-line bg-surface px-3 py-2.5"
          ></textarea>
        </div>

        {turnstileKey && (
          <div class="cf-turnstile" data-sitekey={turnstileKey}></div>
        )}

        <p class="text-sm text-muted">
          Genom att skicka förfrågan godkänner du att vi behandlar uppgifterna enligt vår
          <a class="underline" href="/integritetspolicy">integritetspolicy</a>.
        </p>

        <div>
          <CTAButton type="submit">{cta.send}</CTAButton>
        </div>
      </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const started = form?.querySelector<HTMLInputElement>('[data-started-at]');
  if (started) started.value = String(Date.now());

  form?.querySelectorAll('input, textarea, select').forEach((field) => {
    field.addEventListener('focus', () => document.body.classList.add('hide-sticky'));
    field.addEventListener('blur', () => document.body.classList.remove('hide-sticky'));
  });
</script>

{turnstileKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}
