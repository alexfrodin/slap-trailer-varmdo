---
import { cta, home } from '../data/home';
import { trailerTypes } from '../lib/validation';
import CTAButton from './CTAButton.astro';
import PhoneLink from './PhoneLink.astro';

interface Props {
  heading?: string;
  lead?: string;
  showCallAside?: boolean;
}

const {
  heading = home.formHeading,
  lead = home.formLead,
  showCallAside = true,
} = Astro.props;

const error = Astro.url.searchParams.get('fel');
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="forfragan" class="section scroll-mt-24 bg-elevated">
  <div class:list={['wrap grid gap-10', showCallAside && 'md:grid-cols-[1.2fr_0.8fr]']}>
    <div>
      <h2 class="text-2xl font-semibold md:text-3xl">{heading}</h2>
      <p class="mt-3 text-muted">{lead}</p>

      {error && (
        <p class="mt-4 border border-cta px-4 py-3 text-cta" role="alert">
          {error === 'validering'
            ? 'Kontrollera namn, telefon och beskrivning.'
            : 'Vi kunde inte skicka formuläret. Ring oss eller försök igen.'}
        </p>
      )}

      <form
        class="mt-6 grid gap-4"
        action="/api/contact"
        method="POST"
        enctype="multipart/form-data"
        data-contact-form
      >
        <input type="hidden" name="startedAt" data-started-at />

        <div class="hp" aria-hidden="true">
          <label for="company">Företag</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="name">Namn (obligatorisk)</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            minlength="2"
            maxlength="80"
            autocomplete="name"
            class="w-full border border-line bg-surface px-3 py-2.5"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="phone">Telefonnummer (obligatorisk)</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            class="w-full border border-line bg-surface px-3 py-2.5"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="email">E-post</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            class="w-full border border-line bg-surface px-3 py-2.5"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="regNumber">Registreringsnummer</label>
          <input
            id="regNumber"
            name="regNumber"
            type="text"
            maxlength="16"
            class="w-full border border-line bg-surface px-3 py-2.5 uppercase"
          />
        </div>

        <div>
          <label class="mb-1 block font-medium" for="trailerType">Typ av släp (obligatorisk)</label>
          <select
            id="trailerType"
            name="trailerType"
            required
            class="w-full border border-line bg-surface px-3 py-2.5"
          >
            <option value="">Välj typ av släp</option>
            {trailerTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
        </div>

        <div>
          <label class="mb-1 block font-medium" for="message">Vad behöver du hjälp med? (obligatorisk)</label>
          <textarea
            id="message"
            name="message"
            required
            minlength="10"
            maxlength="2000"
            rows="5"
            class="w-full border border-line bg-surface px-3 py-2.5"
          ></textarea>
        </div>

        <div>
          <label class="mb-1 block font-medium" for="photos">Lägg till bilder</label>
          <input
            id="photos"
            name="photos"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            multiple
            class="w-full text-sm"
          />
          <p class="mt-1 text-sm text-muted">Gärna 1–3 bilder, max ca 1 MB styck.</p>
        </div>

        {turnstileKey && (
          <div class="cf-turnstile" data-sitekey={turnstileKey}></div>
        )}

        <p class="text-sm text-muted">
          Genom att skicka förfrågan godkänner du att vi behandlar uppgifterna enligt vår
          <a class="underline" href="/integritetspolicy">integritetspolicy</a>.
        </p>

        <div>
          <CTAButton type="submit">{cta.send}</CTAButton>
        </div>
      </form>
    </div>

    {showCallAside && (
      <aside class="hidden border border-line bg-surface p-6 md:block">
        <h3 class="text-xl font-semibold">{home.callAsideHeading}</h3>
        <p class="mt-3 text-muted">Samma nummer som i menyn. Vi svarar när vi kan lämna jobbet.</p>
        <p class="mt-4">
          <PhoneLink class="text-2xl font-semibold text-accent no-underline" />
        </p>
      </aside>
    )}
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const started = form?.querySelector<HTMLInputElement>('[data-started-at]');
  if (started) started.value = String(Date.now());

  form?.querySelectorAll('input, textarea, select').forEach((field) => {
    field.addEventListener('focus', () => document.body.classList.add('hide-sticky'));
    field.addEventListener('blur', () => document.body.classList.remove('hide-sticky'));
  });

  const photos = form?.querySelector<HTMLInputElement>('#photos');
  photos?.addEventListener('change', async () => {
    if (!photos.files?.length) return;
    const dt = new DataTransfer();
    for (const file of Array.from(photos.files).slice(0, 3)) {
      dt.items.add(await compressImage(file));
    }
    photos.files = dt.files;
  });

  async function compressImage(file: File): Promise<File> {
    if (!file.type.startsWith('image/')) return file;
    const bitmap = await createImageBitmap(file);
    const max = 1600;
    const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    const ctx = canvas.getContext('2d');
    if (!ctx) return file;
    ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise<Blob | null>((resolve) =>
      canvas.toBlob(resolve, 'image/jpeg', 0.82),
    );
    if (!blob) return file;
    return new File([blob], file.name.replace(/\.\w+$/, '.jpg'), { type: 'image/jpeg' });
  }
</script>

{turnstileKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}
