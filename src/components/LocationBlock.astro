---
import { formattedAddress, isPlaceholder, osmEmbedUrl, site } from '../data/site';
import { home, nav } from '../data/home';

interface Props {
  heading?: string;
}

const { heading = home.locationHeading } = Astro.props;
const showMapLink = !isPlaceholder(site.mapsUrl);
---

<section class="section">
  <div class="wrap grid gap-8 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold md:text-3xl">{heading}</h2>
      <p class="mt-4 text-lg">
        {formattedAddress()}
      </p>
      <p class="mt-2 text-muted">{site.openingHoursLabel}</p>
      {showMapLink && (
        <p class="mt-4">
          <a
            class="font-semibold text-accent underline underline-offset-4"
            href={site.mapsUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {nav.directions}
          </a>
        </p>
      )}
    </div>
    <div class="min-h-64 overflow-hidden border border-line md:min-h-80">
      <iframe
        title={`Karta över verkstaden på ${formattedAddress()}`}
        src={osmEmbedUrl()}
        class="h-full min-h-64 w-full border-0 md:min-h-80"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </div>
</section>
