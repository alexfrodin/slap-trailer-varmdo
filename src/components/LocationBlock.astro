---
import { formattedAddress, isPlaceholder, site } from '../data/site';
import { home, nav } from '../data/home';

interface Props {
  heading?: string;
}

const { heading = home.locationHeading } = Astro.props;
const showMapLink = !isPlaceholder(site.mapsUrl);
---

<section class="section">
  <div class="wrap grid gap-8 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold md:text-3xl">{heading}</h2>
      <p class="mt-4 text-lg">
        {formattedAddress()}
      </p>
      <p class="mt-2 text-muted">{site.openingHoursLabel}</p>
      {showMapLink && (
        <p class="mt-4">
          <a
            class="font-semibold text-accent underline underline-offset-4"
            href={site.mapsUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {nav.directions}
          </a>
        </p>
      )}
    </div>
    <div
      class="flex min-h-52 items-end border border-line bg-accent p-5 text-sm text-[#d7e3de]"
      role="img"
      aria-label={`Karta över verkstaden på ${formattedAddress()}`}
    >
      Värmdö · {site.address.city}
    </div>
  </div>
</section>
