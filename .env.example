# Public site origin, no trailing slash
PUBLIC_SITE_URL=https://slaptrailer.se

# Resend (server only)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Släp & Trailer Värmdö <info@slaptrailer.se>

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Optional cookieless analytics
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional Google Ads conversion tracking. Leave empty locally.
# The tag loads only after consent. See docs/google-ads.md.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=
PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=

# Optional. Leave empty unless a GA4 property should receive events too.
PUBLIC_GA4_MEASUREMENT_ID=
